{
  "expo": {
    "name": "Retangulo.org",
    "slug": "Retangulo",
    "version": "1.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.retangulo.org"
    },
    "extra": {
      "eas": {
        "projectId": "1710d76a-8e42-4ad9-90f6-28b7544ec78b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1710d76a-8e42-4ad9-90f6-28b7544ec78b"
    },
    "androidStatusBar": {
      "backgroundColor": "#2563EB",
      "translucent": false,
      "barStyle": "light-content"
    },
    "plugins": [
      [
        "expo-status-bar",
        {
          "hidden": false,
          "style": "light"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2563EB",
          "image": "./assets/icon.png",
          "imageWidth": 200
        }
      ]
    ]
  }
}